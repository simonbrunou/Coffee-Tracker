.DS_Store
Thumbs.db
*.swp

# NOTE: the following ARE intentionally committed for cross-machine portability:
#   .agents/skills/          vendored agent skills (no re-fetch needed on clone)
#   skills-lock.json         skill version lockfile
#   .mcp.json                shadcn + postgres MCP server config
#   .claude/settings.json    enables typescript-lsp + project hooks
#   .claude/hooks/           block-secrets / format-edited / code-review-on-push
#   .claude/skills/          /migration and /gen-test project skills
#   .claude/agents/          security-reviewer subagent

# graphify knowledge graph: keep the deliverables (graph.html/json, report,
# manifest, memory), ignore the regenerable AST cache and the machine-specific
# absolute-path files.
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root

# UI/UX audit scratch screenshots (working artifacts, not source)
audit-shots/
audit-after/

# --- Nix / direnv dev environment ---
.direnv/
result
