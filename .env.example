# Auth.js — generate a secret with: npx auth secret  (or: openssl rand -base64 33)
AUTH_SECRET=
# REQUIRED in production (boot fails without it): your public origin. Used for auth,
# canonical URLs, OG/social images, sitemap, and verification links. Unset = localhost in dev.
# AUTH_URL=https://your-host/
# Google OAuth (console.cloud.google.com → Credentials → OAuth client)
#   Authorized redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub OAuth (github.com/settings/developers → New OAuth App)
#   Authorization callback URL: <origin>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Existing
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee_tracker
# Postgres TLS (node-postgres). Default OFF — Coolify-internal Postgres needs no TLS.
#   require   = verified TLS (recommended for an EXTERNAL managed Postgres)
#   no-verify = TLS without cert verification (DISCOURAGED — MITM risk; prefer 'require' + CA in trust store)
# Do NOT also put sslmode in DATABASE_URL — a URL sslmode overrides this entirely.
# DATABASE_SSL=require
# Email (Resend) — optional in dev (the verification link is logged instead).
# Required to actually SEND in production; EMAIL_FROM must be on a Resend-verified domain.
# AUTH_URL (above) must also be your public origin in production so the link in the
# email is absolute (it falls back to http://localhost:3000 in dev).
RESEND_API_KEY=
EMAIL_FROM=

# Legal pages (/privacy, /terms, /cookies) — read at request time. Unset → the page
# shows "[to be configured]" (never a fabricated legal fact), so set these before you
# rely on the pages. Defaults below are EU / GDPR-first; CONFIRM ALL WORDING WITH
# QUALIFIED COUNSEL before publishing.
#
# (a) MUST be filled per-deploy — operator/identity facts only you know. The
#     bracketed [...] text is a placeholder, not a real value.
LEGAL_ENTITY="[YOUR NAME], trading as Cortado"
LEGAL_CONTACT="[CONTACT EMAIL — e.g. privacy@your-domain]"
LEGAL_JURISDICTION="the laws of [YOUR EU MEMBER STATE] and the courts located there"
LEGAL_HOSTING="[your application host + region, e.g. a provider in the EU/EEA]"
LEGAL_DB_HOST="[your managed Postgres host + region, e.g. in the EU/EEA]"
LEGAL_LOG_RETENTION="30 days"
#
# (b) OPTIONAL overrides — the app already ships these exact GDPR-first defaults
#     (they describe the app, not the operator), so the pages are complete without
#     them. Set only to override, e.g. a non-EEA host changes LEGAL_DATA_TRANSFER.
LEGAL_MIN_AGE="16"
LEGAL_DSAR_PROCESS="the in-app export (Settings → Your data) and requests to the contact above"
LEGAL_LEGAL_BASES="We process your account and content to perform our agreement with you (Art. 6(1)(b) GDPR), and we rate-limit and secure the service under our legitimate interests (Art. 6(1)(f) GDPR)."
LEGAL_DATA_TRANSFER="We host your data within the EU/EEA. Where a processor operates outside the EEA, transfers are protected by the European Commission's Standard Contractual Clauses or an adequacy decision."
LEGAL_LIABILITY="The service is provided 'as is' without warranties of any kind. To the fullest extent permitted by law we are not liable for indirect or consequential loss; nothing here limits liability that cannot be limited under applicable law."
LEGAL_DB_TLS="Database connections are encrypted with TLS in production."
